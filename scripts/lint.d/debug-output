#
# The debug-output policy check (scripts/check_debug_output.py): no
# config fragment may silently reduce debug output without a recorded
# `# debug-output: approved <reason>` marker ("Debug output is
# load-bearing"). From this repository's own .venv; extra arguments are
# passed through.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
venv="$root/.venv"

if [ ! -x "$venv/bin/python" ]; then
  echo "lint.d/debug-output: no .venv found. Create it first: python3.13 -m venv .venv && .venv/bin/pip install --group dev (see README)." >&2
  exit 1
fi

cd "$root"
exec "$venv/bin/python" scripts/check_debug_output.py "$@"
