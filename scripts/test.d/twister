#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 The MCUHome Contributors
# SPDX-License-Identifier: Apache-2.0
#
# The Zephyr test suites in tests/, compiled and run in MCUHome's build
# environment. The environment is the package set
# docs/design/build-environment.md names — a build workspace and a build
# tools package — and it is delivered in one of two ways, so this wrapper
# runs in one of two modes:
#
#   PACKAGE MODE, when MCUHOME_SDK_BUILD_TOOLS names an unpacked
#   mcuhome-build-tools package. The suites are compiled on this host with
#   that package's tools, in the west workspace the first argument names —
#   which is the unpacked mcuhome-build-workspace package with this
#   checkout put where the manifest repository belongs. This is what
#   ci-build.yml's test-twister job does: it compiles in the environment
#   the commit under test produces, not in a published one.
#
#   IMAGE MODE, when it does not. The suites are compiled inside a build
#   environment image — an assembly of those same two packages, tagged
#   `<workspace package version>-r<n>` — taken from what is already on this
#   machine, the highest assembly revision present and the workspace
#   version this checkout declares first. This wrapper never fetches
#   anything, so "the newest one you have" is the only question it can
#   answer offline.
#
# What neither mode does is prepare its input. Unpacking the packages,
# creating the build's virtual environment from the wheel set they ship,
# pulling an image, laying a workspace out — all of that needs network or
# gigabytes of disk and is the caller's, as ci-build.yml's job shows. A
# missing prerequisite is reported as a failure that says what to prepare,
# never done silently.
#
# The tools are not on PATH in either mode: the environment's entry point
# sets PATH, VIRTUAL_ENV and the Zephyr toolchain variables so that both
# build profiles get the same environment out of one file, and that entry
# point runs a build step rather than a shell. This wrapper therefore
# states the same variables itself, from the tools root — which is the
# environment owner's own side of the boundary and stays in this
# repository.
#
# The west workspace top directory — the T2 workspace: `.west/`,
# `zephyr/`, `modules/`, `bootloader/` beside this repository checked out
# as `mcuhome-sdk/` — defaults to the directory this repository
# *physically* lies in. That is the development layout and it is the only
# one west supports: `west init -l` resolves a symlinked manifest
# repository and anchors the workspace at its physical parent, so the
# checkout has to live in the workspace directory, and a convenience
# symlink somewhere else points into it. A checkout that sits where it
# belongs therefore needs nothing set. Another workspace is named as this
# wrapper's first argument — one that does not start with `-`, so an
# option meant for `west twister` is never read as a path — or in the
# MCUHOME_SDK_WEST_WORKSPACE environment variable — mirroring the
# buildserver's test.d/e2e (MCUHOME_E2E_SDK_DIR) precedent — which is what
# CI does, where the workspace is an unpacked package. The suites are
# compiled against the *workspace* the manifest of this checkout
# describes, never against one somebody baked earlier: a change to
# west.yml has to be tested against what it pins. Extra arguments,
# including a leading option, are passed through to `west twister`, so
# `-j` stays overridable (twister keeps the last occurrence of a repeated
# option) whether or not a workspace is also named.
#
# Twister's output — build trees, logs, the report — goes into a fresh
# temporary directory and is removed when the run ends, in both modes. It
# is build output: it belongs to the run and not to the workspace, to
# this repository or to whatever directory the wrapper was called from,
# and none of those is a place to leave a `twister-out/` in. To read it
# after a failure, set MCUHOME_SDK_TWISTER_KEEP=1 — then the directory
# survives the run and its path is printed.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# $1 is the workspace only when it does not start with `-`; a leading
# option (e.g. `-j 4`) is left for west twister below, and the workspace
# then comes only from MCUHOME_SDK_WEST_WORKSPACE.
if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
  workspace="$1"
  shift
else
  workspace="${MCUHOME_SDK_WEST_WORKSPACE:-}"
fi

# No workspace stated: the one this checkout physically lies in. `pwd -P`
# rather than `pwd`, because the path the wrapper was reached through may
# run over a symlink and west anchors on the physical one. What a missing
# .west/ means differs between the two, so the refusal does too.
if [ -z "$workspace" ]; then
  workspace="$(dirname "$(cd "$root" && pwd -P)")"
  no_workspace="That is the directory this checkout physically lies in, which is where the development workspace belongs: run west init -l mcuhome-sdk && west update there. A different one is named as the first argument or in MCUHOME_SDK_WEST_WORKSPACE."
else
  no_workspace="Name the top directory of one instead: west init -l mcuhome-sdk && west update makes one, and an unpacked mcuhome-build-workspace package carries one in its 'workspace' directory."
fi

if [ ! -d "$workspace/.west" ]; then
  echo "test.d/twister: '$workspace' has no .west/ — it is not a west workspace. $no_workspace" >&2
  exit 1
fi

if [ ! -e "$workspace/mcuhome-sdk" ]; then
  echo "test.d/twister: '$workspace/mcuhome-sdk' does not exist — the west workspace has no manifest-repo checkout at the path twister expects." >&2
  exit 1
fi

# The command every mode ends in. `-T` is relative to the workspace, which
# is the working directory in both.
suite="mcuhome-sdk/tests/twister"

# Twister's output directory. It is made once a mode's own prerequisites
# hold — a refusal leaves nothing behind — and removed by the exit trap,
# which also catches the interrupted run.
#
# Twister is given a path *inside* it that does not exist yet, because an
# --outdir that already exists is read as a previous run and moved aside
# (twister_main.clean_previous_results). In the container that move hits
# the bind mount of this very directory and fails with EPERM; outside it
# would just leave a second directory behind. A fresh subdirectory has
# neither problem.
outdir=""

cleanup() {
  [ -n "$outdir" ] || return 0
  if [ "${MCUHOME_SDK_TWISTER_KEEP:-}" = "1" ]; then
    echo "test.d/twister: output kept in $outdir" >&2
    return 0
  fi
  rm -rf "$outdir"
}
trap cleanup EXIT

make_outdir() {
  outdir="$(mktemp -d "${TMPDIR:-/tmp}/mcuhome-twister-XXXXXXXX")"
  results="$outdir/twister-out"
}

# --------------------------------------------------------------------------
# Package mode: this host, the tools out of an unpacked package
# --------------------------------------------------------------------------
tools="${MCUHOME_SDK_BUILD_TOOLS:-}"
if [ -n "$tools" ]; then
  if [ ! -f "$tools/build-tools.json" ]; then
    echo "test.d/twister: '$tools' carries no build-tools.json, so it is not an unpacked mcuhome-build-tools package. MCUHOME_SDK_BUILD_TOOLS has to name the directory the package's archive unpacks into." >&2
    exit 1
  fi
  if [ ! -x "$tools/venv/bin/python3" ]; then
    echo "test.d/twister: '$tools' has no build environment at venv/. The package ships wheels rather than a ready environment — create it once with the host's Python 3.13: python3 -m venv '$tools/venv' && '$tools/venv/bin/python' -m pip install --no-index --find-links '$tools/wheels' '$tools'/wheels/*.whl" >&2
    exit 1
  fi

  echo "test.d/twister: using the tools package in $tools" >&2

  PATH="$tools/venv/bin:$tools/cmake/bin:$tools/ninja:$tools/gn:$PATH"
  export PATH
  VIRTUAL_ENV="$tools/venv"
  export VIRTUAL_ENV
  ZEPHYR_TOOLCHAIN_VARIANT=zephyr
  export ZEPHYR_TOOLCHAIN_VARIANT
  for candidate in "$tools"/zephyr-sdk-*; do
    if [ -d "$candidate" ]; then
      ZEPHYR_SDK_INSTALL_DIR="$candidate"
      export ZEPHYR_SDK_INSTALL_DIR
    fi
  done

  make_outdir
  cd "$workspace"
  status=0
  west twister -T "$suite" --integration --inline-logs -v -j 2 \
    -O "$results" "$@" || status=$?
  exit "$status"
fi

# --------------------------------------------------------------------------
# Image mode: a build environment image that is already on this machine
# --------------------------------------------------------------------------
venv="$root/.venv"

if [ ! -x "$venv/bin/python" ]; then
  echo "test.d/twister: no .venv found. Create it first — see README, \"Development — how to work on this repository\"." >&2
  exit 1
fi

if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
  echo "test.d/twister: no reachable container runtime. Install/start docker first, or set MCUHOME_SDK_BUILD_TOOLS to an unpacked mcuhome-build-tools package to compile on this host instead." >&2
  exit 1
fi

if ! repository="$("$venv/bin/python" -c "
import sys
sys.path.insert(0, '$root')
from mcuhome.model.buildenvironment import ENVIRONMENT_IMAGE_REPOSITORY
print(ENVIRONMENT_IMAGE_REPOSITORY)
" 2>/dev/null)"; then
  echo "test.d/twister: could not resolve the build environment's image repository from mcuhome.model.buildenvironment." >&2
  exit 1
fi

# The image tags are `<workspace package version>-r<n>`, so the version the
# preference below wants is the *workspace* line's, out of the one file that
# declares the three release lines. The SDK's own version names no image and
# matched no tag when it was asked here instead.
version="$("$venv/bin/python" "$root/scripts/release_lines.py" \
  version workspace 2>/dev/null)" || version=""

# The highest assembly revision on this machine, the workspace version this
# checkout declares preferred. `docker images` is asked rather than a
# registry: this wrapper does not fetch, so what is here is the whole answer.
image="$(
  docker images --format '{{.Repository}}:{{.Tag}}' "$repository" 2>/dev/null |
  awk -F: -v wanted="$version" '
    $NF ~ /-r[0-9]+$/ {
      tag = $NF
      revision = tag
      sub(/^.*-r/, "", revision)
      preferred = (wanted != "" && index(tag, wanted "-r") == 1) ? 1 : 0
      if (preferred > best_preferred || (preferred == best_preferred && revision + 0 > best)) {
        best_preferred = preferred
        best = revision + 0
        chosen = $0
      }
    }
    END { if (chosen != "") print chosen }
  '
)"

if [ -z "$image" ]; then
  echo "test.d/twister: no build environment image of $repository is present locally, and MCUHOME_SDK_BUILD_TOOLS names no unpacked tools package either. Pull a published assembly of this release's environment first (this wrapper never pulls it), or point MCUHOME_SDK_BUILD_TOOLS at an unpacked mcuhome-build-tools package as ci-build.yml's test-twister job does." >&2
  exit 1
fi

echo "test.d/twister: using $image" >&2

make_outdir

# The output directory is mounted at its own path so that what twister
# writes lands on the host, outside the workspace and outside this
# repository, and goes away with the run.
status=0
docker run --rm --user "$(id -u):$(id -g)" \
  --volume "$workspace:$workspace" --volume "$outdir:$outdir" \
  --workdir "$workspace" \
  "$image" \
  sh -euc '
    suite="$1"
    results="$2"
    shift 2
    tools="${MCUHOME_BUILD_ENV_TOOLS:?the image states no build tools directory}"
    PATH="$tools/venv/bin:$tools/cmake/bin:$tools/ninja:$tools/gn:$PATH"
    export PATH
    VIRTUAL_ENV="$tools/venv"
    export VIRTUAL_ENV
    ZEPHYR_TOOLCHAIN_VARIANT=zephyr
    export ZEPHYR_TOOLCHAIN_VARIANT
    for candidate in "$tools"/zephyr-sdk-*; do
      if [ -d "$candidate" ]; then
        ZEPHYR_SDK_INSTALL_DIR="$candidate"
        export ZEPHYR_SDK_INSTALL_DIR
      fi
    done
    exec west twister -T "$suite" --integration --inline-logs -v -j 2 \
      -O "$results" "$@"
  ' twister "$suite" "$results" "$@" || status=$?
exit "$status"
