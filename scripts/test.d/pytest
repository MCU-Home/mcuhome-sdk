#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 The MCUHome Contributors
# SPDX-License-Identifier: Apache-2.0
#
# pytest, from this repository's own .venv. Only the Python suite in
# tests/python/ ([tool.pytest.ini_options] testpaths) — deliberately NOT
# twister (see test.d/twister) and NOT a firmware build: no canonical
# build entry point exists yet. Extra arguments are passed through. See
# CONTRIBUTING.md ("Repository layout").
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
venv="$root/.venv"

if [ ! -x "$venv/bin/python" ]; then
  echo "test.d/pytest: no .venv found. Create it first — see README, \"Development — how to work on this repository\"." >&2
  exit 1
fi

cd "$root"
exec "$venv/bin/python" -m pytest "$@"
