#!/usr/bin/env python3
# SPDX-FileCopyrightText: 2026 The MCUHome Contributors
# SPDX-License-Identifier: Apache-2.0
#
# The SDK package's entry point. `mcuhome-sdk.json` at the SDK root names
# this file as `generate.program`, and a build environment invokes it as
#
#     <the delivered SDK>/bin/generate generate <request-document path>
#
# — two operands, a request document and a result document, the ABI
# `mcuhome.compiler.abi.run_invocation` implements for both ends of that
# call. Everything this file does is call mcuhome.compiler.sdkentry.main()
# with that argv; the action lives there, not here, so a test can drive it
# in-process while this file stays the three lines a launcher should be.
#
# The runtime this file needs is what `generate.runtime` declares
# ("python3"), and providing it is the build environment's duty — which
# is why the shebang may assume it. sys.path gains the SDK root because
# the mcuhome package sits inside the SDK tree and this launcher is
# invoked by absolute path from anywhere, with no install step and no
# PYTHONPATH promise: no environment variable carries information this
# program needs.

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from mcuhome.compiler.sdkentry import main  # noqa: E402 - needs the path above

raise SystemExit(main(sys.argv))
