#
# The build-environment packager: the pinned toolchain MCUHome's two
# build-environment packages are produced in.
#
# `scripts/build_env_package.py` runs three things inside this image, and
# each is here because it cannot be done correctly on an arbitrary host:
#
#   the west workspace     laid out by the exact `west` that will later
#                          read it, at the pin below — a version skew
#                          between the two is a difference nobody can see
#                          from outside.
#   the Matter data model  pre-generated by the exact `zap` the pinned
#                          CHIP revision names. zap is distributed only as
#                          a packaged Electron application and needs a
#                          desktop shared-library set no lean build
#                          environment carries, which is why the
#                          pre-generation happens here once per release
#                          instead of in every build.
#   the wheel set          built by the interpreter of the base image the
#                          build environment itself runs on, because the
#                          interpreter that builds a wheel decides which
#                          interpreter can install it. That base is
#                          `debian:trixie-slim` at the digest below, and
#                          it carries no interpreter at all (measured:
#                          `python3` exits 127) — this image is that base
#                          plus `python3`, which is what makes the ABI
#                          statement checkable.
#
# What it deliberately does NOT carry: the Zephyr SDK, cmake, ninja, gn,
# ccache, a baked west workspace, an entry point, or any part of a build
# environment. Nothing is compiled in this image. A device is built in
# `ghcr.io/mcu-home/build-environment`, which is an assembly of the two
# packages this image produces (`containers/build-environment/`).
#
# Published as `ghcr.io/mcu-home/build-environment-packager`, tagged
# `<sdk version>-r<n>`: the SDK version this packager is first needed for
# — "for SDKs from this version on" — plus a counter for rebuilds with the
# same tool set (a base refresh, a security fix). The tag is a location;
# the identity is the digest, and `scripts/packager_image.py` is the one
# place in this repository that states both.
#
# Build (the context is THIS directory — unlike the image it replaced,
# nothing outside it is an input):
#     docker build -t ghcr.io/mcu-home/build-environment-packager:<tag> \
#         containers/build-environment-packager
#
# Multi-architecture, amd64 and arm64: the wheel set is per architecture
# and has to be built natively on each. `.github/workflows/ci-build.yml`
# builds one manifest per architecture and composes the index.
#
# Everything downloaded is checksum-verified. An image that silently
# absorbs a re-tagged upstream artifact is not a reproducible toolchain.

# --------------------------------------------------------------------------
# Versions — every one of them pinned on purpose
# --------------------------------------------------------------------------
#
# The base is `debian:trixie-slim`, digest-pinned because the tag moves
# with every point release. It is the same pin the build environment's own
# image uses and the same one `scripts/build_env_package.py` names as
# BASE_IMAGE; `tests/python/test_env_image.py` holds the three statements
# together.
#
# The digest is an **index** and therefore says nothing about
# architecture — it names both, and each build takes the manifest for the
# platform it is building. A digest that named one manifest would pin one
# architecture and make the other unbuildable, which is worth knowing
# before somebody "simplifies" this pin.
ARG DEBIAN_IMAGE=debian:trixie-slim@sha256:3a39a0592364683e6bab97937b72cad5a8fa6dcbbee90edb3bb48c7f8e94f258

# The interpreter that decides the wheel set's ABI. It is not installed
# from here — it is whatever `python3` the base's apt carries, and it is
# therefore pinned by the base digest above. This value is restated so it
# can be declared in a label, and the last stage checks it against the
# interpreter that is actually in the image, so a base refresh that moves
# the interpreter fails the build instead of publishing a label that lies.
ARG PYTHON_VERSION=3.13.5

# west, restated from requirements.txt for the same reason: the label has
# to carry a value, and `west --version` is asked at the end of the build
# whether this is the one that got installed.
ARG WEST_VERSION=1.5.0

# zap: generates the Matter root-node data model from the framework's
# `.zap` (`components/matter/zap/`). The version is the pinned CHIP
# revision's own pin, `scripts/setup/zap.version` inside that revision —
# taking it from anywhere else would let the generated data model drift
# away from the SDK that consumes it. The derivation is checked where it
# matters: CHIP's `scripts/tools/zap/generate.py` compares `zap-cli
# --version` against that file's version on every pre-generation run, so
# a packager whose zap fell behind the pinned CHIP fails the package
# build rather than producing a data model nobody asked for.
ARG ZAP_VERSION=v2025.10.23-nightly
ARG ZAP_SHA256_AMD64=fe327379a07f22fb91661b6a80c1e58c8f84f5af1d8dd1288b7fb69c8ef75ac0
ARG ZAP_SHA256_ARM64=9b9c41d2c0384acec6f47e7aab286166890e572219084fd6b8c5b78d66604de4

# --------------------------------------------------------------------------
# Stage 1: fetch and unpack, so the final image never carries the archive
# --------------------------------------------------------------------------
FROM ${DEBIAN_IMAGE} AS fetch

# The platform this stage is being built for. It is a fallback, not the
# source: BuildKit fills TARGETARCH in, the classic builder leaves it
# empty, and this file has to build under both — so the architecture is
# read from the stage itself with `dpkg --print-architecture`, which is the
# truth about the platform this RUN executes on and needs no builder
# feature at all. The two never disagree: the stage runs on the target,
# natively or emulated.
ARG TARGETARCH
ARG ZAP_VERSION
ARG ZAP_SHA256_AMD64
ARG ZAP_SHA256_ARM64

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        ca-certificates \
        curl \
        unzip \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /fetch

# zap — a packaged Electron application; the zip is flat, so it unpacks
# straight into its own directory. The .deb of the same release is not
# used: it ships only the GUI binary, not the zap-cli the generators call.
RUN arch="${TARGETARCH:-$(dpkg --print-architecture)}" \
 && case "${arch}" in \
      amd64) host=linux-x64;   zap_sha="${ZAP_SHA256_AMD64}" ;; \
      arm64) host=linux-arm64; zap_sha="${ZAP_SHA256_ARM64}" ;; \
      *) echo "this image is built for amd64 and arm64, not for '${arch}'" >&2; exit 1 ;; \
    esac \
 && curl -fsSL -o zap.zip \
        "https://github.com/project-chip/zap/releases/download/${ZAP_VERSION}/zap-${host}.zip" \
 && echo "${zap_sha}  zap.zip" | sha256sum -c - \
 && mkdir -p /opt/zap \
 && unzip -q zap.zip -d /opt/zap \
 && chmod +x /opt/zap/zap /opt/zap/zap-cli \
 && rm zap.zip

# --------------------------------------------------------------------------
# Stage 2: the image itself
# --------------------------------------------------------------------------
FROM ${DEBIAN_IMAGE}

ARG DEBIAN_IMAGE
ARG PYTHON_VERSION
ARG WEST_VERSION
ARG ZAP_VERSION

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Three groups, kept apart so the reason for each package survives:
#
#   python      the interpreter that decides the wheel set's ABI, and the
#               venv module the wheel build creates its throwaway
#               environment with. From the base's apt, so the base digest
#               pins them.
#   workspace   git for `west update`, the tag fetches and `git apply`;
#               ca-certificates for every https clone and download.
#   electron    zap is a prebuilt Electron binary and links against the
#               desktop stack even when it never opens a window; the list
#               is the Depends: field of the upstream zap .deb.
#
# No compiler: the wheel build needs none. Every requirement of the build
# environment either publishes a wheel for this interpreter or is pure
# Python, which is what the tools package's own build proves on every run.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        python3 \
        python3-venv \
        ca-certificates \
        git \
        libatspi2.0-0t64 \
        libgtk-3-0t64 \
        libnotify4 \
        libnss3 \
        libsecret-1-0 \
        libuuid1 \
        libxss1 \
        libxtst6 \
 && rm -rf /var/lib/apt/lists/*

# The packager's own Python environment. A virtualenv rather than the
# system interpreter so the image never fights Debian's PEP 668 marker,
# and so `python3` inside a packaging step means one thing.
#
# `--no-deps` and then `pip check`: requirements.txt states the whole
# transitive closure, and this is what turns that statement into a check.
# Without it a forgotten dependency would arrive unpinned and nobody would
# notice until two packager revisions produced different generated code.
#
# The system interpreter stays reachable at /usr/bin/python3 and is what
# the wheel build uses — a virtual environment inside a virtual
# environment is not what decides an ABI.
COPY requirements.txt /opt/requirements.txt
RUN python3 -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir --disable-pip-version-check \
        --no-deps -r /opt/requirements.txt \
 && /opt/venv/bin/pip check

COPY --from=fetch /opt/zap /opt/zap

ENV PATH=/opt/venv/bin:/opt/zap:/usr/local/bin:/usr/bin:/bin \
    VIRTUAL_ENV=/opt/venv \
    ZAP_INSTALL_PATH=/opt/zap

# What this image is, stated so a reader of the registry does not have to
# guess, and so the pin in `scripts/packager_image.py` can be checked
# against the bytes it names. Every value below is verified against the
# image in the next step: a label is scheduling data, and scheduling data
# that lies is worse than none.
LABEL org.opencontainers.image.title="MCUHome build-environment packager" \
      org.opencontainers.image.description="The pinned toolchain MCUHome's build-environment packages are produced in: west, zap, and the base image's Python." \
      org.opencontainers.image.source="https://github.com/mcu-home/mcuhome-sdk" \
      org.opencontainers.image.licenses="Apache-2.0"

LABEL org.mcuhome.build-environment-packager.base="${DEBIAN_IMAGE}" \
      org.mcuhome.build-environment-packager.python="${PYTHON_VERSION}" \
      org.mcuhome.build-environment-packager.west="${WEST_VERSION}" \
      org.mcuhome.build-environment-packager.zap="${ZAP_VERSION}"

# Every label above is the ARG that decided the image, and this step is
# what makes that a fact rather than a claim: it asks the image what it
# actually carries and fails the build on any disagreement. So a label
# can only be wrong if the image is wrong with it — including one moved
# by a `--build-arg`, which fails here rather than shipping a value the
# bytes never saw. `base` is the exception and cannot be checked from
# inside: a container cannot see the digest it was built from, so that
# label states the base this build was given, which is the most a build
# can honestly say about it.
#
# `zap-cli --version` prints the date-shaped version CHIP's generator
# compares against, without the leading `v` and without the channel
# suffix — the same transformation the generator does.
RUN set -euo pipefail; \
    python="$(/usr/bin/python3 -c 'import platform; print(platform.python_version())')"; \
    if [ "${python}" != "${PYTHON_VERSION}" ]; then \
        echo "the base carries python ${python}, not ${PYTHON_VERSION}" >&2; exit 1; \
    fi; \
    west="$(west --version)"; \
    if [ "${west}" != "West version: v${WEST_VERSION}" ]; then \
        echo "requirements.txt installed '${west}', not west ${WEST_VERSION}" >&2; exit 1; \
    fi; \
    expected="${ZAP_VERSION#v}"; \
    expected="${expected%-nightly}"; \
    zap="$(zap-cli --version)"; \
    if ! printf '%s' "${zap}" | grep -q "^Version: ${expected}$"; then \
        echo "the installed zap is not ${ZAP_VERSION}:" >&2; echo "${zap}" >&2; exit 1; \
    fi; \
    python3 -c 'import west, click, jinja2, lark, coloredlogs, requests, jsonschema'; \
    git --version

# No ENTRYPOINT: `scripts/build_env_package.py` runs this image with a
# full `/bin/sh -euc <script>` command line, three times per workspace
# package and once per tools package, and an entrypoint would only get in
# the way. `docker run --rm <image> west --version` has to keep working
# too — it is how a reader checks what the labels claim.
CMD ["/bin/bash"]
